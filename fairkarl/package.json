{
  "name": "fairkarl",
  "version": "1.0.0",
  "description": "FairKarl - AI-first, agent-native car insurance for any car, anywhere. Zero-dependency core insurance system with REST, OpenAPI, MCP and A2A interfaces.",
  "type": "module",
  "main": "src/server.js",
  "bin": { "fairkarl-mcp": "bin/mcp-stdio.js" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "mcp": "node --disable-warning=ExperimentalWarning bin/mcp-stdio.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "engines": { "node": ">=22.13" },
  "license": "UNLICENSED"
}
